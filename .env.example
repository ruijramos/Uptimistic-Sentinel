# ==============================================================================
# Uptimistic-Sentinel - Infrastructure & Secrets Configuration
# ==============================================================================
# NOTE: Operational rules (recipient emails, intervals, timeouts, alert thresholds)
# are stored in the PostgreSQL database and managed dynamically via the UI.
# This file is strictly for infrastructure secrets, connection strings, and ports.

# Flask Application
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
API_PORT=5000
CORS_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost

# PostgreSQL Persistence
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secure_pass
POSTGRES_DB=uptimistic_sentinel
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# SMTP Relay Infrastructure (Used by native smtplib)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_DEFAULT_FROM=Uptimistic Sentinel <alerts@example.com>
